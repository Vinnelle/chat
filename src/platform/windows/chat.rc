// Version information and manifest for chat.exe. Windows shows the version information under
// the file's Properties, Details. CHAT_VERSION and CHAT_VERSION_N (the same, comma separated)
// come from CMakeLists.txt.
#include <winver.h>

1 24 "chat.manifest"

1 VERSIONINFO
FILEVERSION     CHAT_VERSION_N,0
PRODUCTVERSION  CHAT_VERSION_N,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "chat"
            VALUE "FileDescription",  "chat, an end-to-end encrypted terminal chat"
            VALUE "FileVersion",      CHAT_VERSION
            VALUE "InternalName",     "chat"
            VALUE "LegalCopyright",   "Copyright (C) 2026 finlay@tuta.com, GPL-3.0-only"
            VALUE "OriginalFilename", "chat.exe"
            VALUE "ProductName",      "chat"
            VALUE "ProductVersion",   CHAT_VERSION
            VALUE "Comments",         "https://github.com/Vinnelle/chat"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
